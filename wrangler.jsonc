{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "photo-voting-web",
  "main": "web/index.ts",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "services": [
    {
      "binding": "API",
      "service": "photo-voting-api",
    },
  ],
  "previews": {},
}
